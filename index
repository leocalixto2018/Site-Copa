<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="theme-color" content="#080C18">
<title>Copa do Mundo 2002</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow:ital,wght@0,300;0,400;0,500;0,600;1,300&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --gold:#D4A017;--gold-l:#F5C842;--gold-d:#A07010;
  --bg:#080C18;--bg2:#0F1525;--bg3:#16202E;--bg4:#1C2A3A;
  --text:#EAE6DC;--muted:#7A8BA8;--green:#00A83C;
  --r:12px;--r-sm:8px;
}
html{scroll-behavior:smooth;-webkit-tap-highlight-color:transparent;}
body{font-family:'Barlow',sans-serif;background:var(--bg);color:var(--text);overflow-x:hidden;font-size:15px;}
img{max-width:100%;}

/* ── NAV ── */
nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  background:rgba(8,12,24,0.92);backdrop-filter:blur(16px);
  border-bottom:1px solid rgba(212,160,23,0.15);
  padding:0 1rem;height:52px;
  display:flex;align-items:center;justify-content:space-between;
}
.nav-brand{font-family:'Bebas Neue',sans-serif;font-size:1.4rem;color:var(--gold-l);letter-spacing:.05em;text-decoration:none;}
.hamburger{background:none;border:none;cursor:pointer;padding:6px;display:flex;flex-direction:column;gap:5px;}
.hamburger span{display:block;width:22px;height:2px;background:var(--text);border-radius:2px;transition:all .3s;}
.hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
.hamburger.open span:nth-child(2){opacity:0;}
.hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
.nav-menu{
  position:fixed;top:52px;left:0;right:0;bottom:0;
  background:rgba(8,12,24,0.97);backdrop-filter:blur(20px);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:2rem;list-style:none;
  transform:translateX(100%);transition:transform .3s cubic-bezier(.16,1,.3,1);z-index:199;
}
.nav-menu.open{transform:none;}
.nav-menu a{font-family:'Bebas Neue',sans-serif;font-size:2rem;color:var(--muted);text-decoration:none;letter-spacing:.1em;transition:color .2s;}
.nav-menu a:hover{color:var(--gold-l);}

/* ── HERO ── */
.hero{
  min-height:100svh;display:flex;flex-direction:column;
  align-items:center;justify-content:center;text-align:center;
  padding:5rem 1.25rem 3rem;
  background:radial-gradient(ellipse 120% 80% at 50% 60%,#0d2254 0%,var(--bg) 65%);
  position:relative;overflow:hidden;
}
.hero::before{
  content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(0deg,transparent,transparent 47px,rgba(255,255,255,.018) 47px,rgba(255,255,255,.018) 48px),
  repeating-linear-gradient(90deg,transparent,transparent 47px,rgba(255,255,255,.018) 47px,rgba(255,255,255,.018) 48px);
  pointer-events:none;
}
.ball{font-size:5rem;animation:spin 12s linear infinite;margin-bottom:1rem;display:block;filter:drop-shadow(0 0 24px rgba(212,160,23,.35));}
@keyframes spin{to{transform:rotate(360deg);}}
.hero-eye{font-size:.65rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);margin-bottom:.6rem;font-weight:600;}
.hero-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(3.5rem,18vw,6rem);line-height:.92;letter-spacing:.02em;margin-bottom:.75rem;}
.hero-title em{color:var(--gold-l);font-style:normal;}
.hero-sub{font-size:.9rem;color:var(--muted);font-style:italic;line-height:1.6;max-width:280px;margin:0 auto 2rem;}
.hero-chips{display:flex;gap:.5rem;justify-content:center;flex-wrap:wrap;}
.chip{background:rgba(212,160,23,.12);border:1px solid rgba(212,160,23,.3);border-radius:100px;padding:5px 14px;font-size:.78rem;font-weight:600;color:var(--gold-l);}
.scroll-down{margin-top:2.5rem;display:flex;flex-direction:column;align-items:center;gap:6px;font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);}
.scroll-down::after{content:'';width:1px;height:32px;background:linear-gradient(to bottom,var(--gold),transparent);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:.3;}50%{opacity:1;}}

/* ── SECTIONS ── */
section{padding:3rem 1.25rem;}
.sec-eye{font-size:.6rem;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:600;margin-bottom:.4rem;}
.sec-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(2rem,9vw,2.8rem);line-height:1;margin-bottom:1rem;}
.gold-rule{border:none;border-top:1px solid rgba(212,160,23,.3);margin-bottom:1.2rem;}

/* ── FINAL ── */
.final-box{
  background:linear-gradient(160deg,#0d2254,var(--bg3));
  border:1px solid rgba(212,160,23,.4);border-radius:var(--r);
  padding:1.5rem 1rem;text-align:center;
}
.final-date{font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:1.25rem;}
.final-teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:.75rem;}
.team-flag{font-size:2.8rem;display:block;}
.team-name{font-family:'Bebas Neue',sans-serif;font-size:1.3rem;color:var(--text);letter-spacing:.05em;}
.team-role{font-size:.65rem;color:var(--muted);margin-top:2px;}
.score{font-family:'Bebas Neue',sans-serif;font-size:clamp(2.8rem,12vw,4rem);color:var(--gold-l);line-height:1;}
.goal-chips{display:flex;gap:.4rem;justify-content:center;flex-wrap:wrap;margin-top:1rem;}
.goal-chip{background:rgba(212,160,23,.1);border:1px solid rgba(212,160,23,.25);border-radius:100px;padding:4px 12px;font-size:.75rem;color:var(--gold-l);font-weight:600;}

/* ── PODIUM ── */
.podium{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-top:1.2rem;}
.pod-card{background:var(--bg3);border-radius:var(--r);padding:1rem;text-align:center;border:1px solid rgba(255,255,255,.06);}
.pod-card.g1{border-color:rgba(212,160,23,.45);background:linear-gradient(160deg,rgba(212,160,23,.1),var(--bg3));}
.pod-place{font-family:'Bebas Neue',sans-serif;font-size:2rem;line-height:1;}
.g1 .pod-place{color:var(--gold-l);}
.pod-flag{font-size:1.8rem;margin:.3rem 0;}
.pod-name{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;letter-spacing:.04em;}
.pod-detail{font-size:.7rem;color:var(--muted);margin-top:.3rem;line-height:1.5;}

/* ── SCORERS ── */
.scorer{display:flex;align-items:center;gap:.75rem;padding:.85rem .75rem;background:var(--bg3);border-radius:var(--r-sm);border:1px solid rgba(255,255,255,.06);margin-bottom:.5rem;transition:border-color .2s;}
.scorer.top{background:linear-gradient(90deg,rgba(212,160,23,.1),var(--bg3));border-color:rgba(212,160,23,.35);}
.sc-rank{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;color:var(--muted);min-width:18px;text-align:center;}
.sc-flag{font-size:1.3rem;}
.sc-info{flex:1;}
.sc-name{font-weight:600;font-size:.88rem;color:var(--text);}
.sc-country{font-size:.72rem;color:var(--muted);}
.sc-bar-wrap{display:flex;align-items:center;gap:.5rem;min-width:80px;}
.sc-bar-bg{flex:1;height:5px;background:rgba(255,255,255,.08);border-radius:3px;overflow:hidden;}
.sc-bar{height:100%;border-radius:3px;background:var(--gold);width:0;transition:width 1.2s cubic-bezier(.16,1,.3,1);}
.top .sc-bar{background:linear-gradient(90deg,var(--gold),var(--gold-l));}
.sc-goals{font-family:'Bebas Neue',sans-serif;font-size:1.3rem;color:var(--gold-l);min-width:22px;text-align:right;}

/* ── BRACKET (mobile-first vertical) ── */
.bracket-section{display:flex;flex-direction:column;gap:.5rem;}
.round-label{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);font-weight:600;padding:.4rem 0 .2rem;margin-top:.5rem;}
.match{background:var(--bg3);border:1px solid rgba(255,255,255,.07);border-radius:var(--r-sm);overflow:hidden;margin-bottom:.35rem;}
.match.final-m{border-color:rgba(212,160,23,.45);background:linear-gradient(135deg,rgba(212,160,23,.08),var(--bg3));}
.match-team{display:flex;justify-content:space-between;align-items:center;padding:7px 10px;font-size:.85rem;gap:8px;}
.match-team+.match-team{border-top:1px solid rgba(255,255,255,.05);}
.mt-name{flex:1;}
.mt-score{font-family:'Bebas Neue',sans-serif;font-size:1.05rem;}
.winner .mt-name,.winner .mt-score{color:var(--gold-l);font-weight:600;}
.loser{color:var(--muted);}
.champion-badge{text-align:center;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);padding:.35rem;font-weight:700;}

/* ── GROUPS ── */
.conf-filter{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1rem;overflow-x:auto;padding-bottom:4px;}
.conf-filter::-webkit-scrollbar{display:none;}
.fbtn{background:var(--bg3);border:1px solid rgba(255,255,255,.1);border-radius:100px;padding:5px 13px;font-size:.75rem;color:var(--muted);cursor:pointer;white-space:nowrap;font-family:'Barlow',sans-serif;transition:all .15s;}
.fbtn.active{background:var(--gold);border-color:var(--gold);color:#000;font-weight:600;}
.groups-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;}
@media(max-width:340px){.groups-grid{grid-template-columns:1fr;}}
.gcard{background:var(--bg3);border:1px solid rgba(255,255,255,.06);border-radius:var(--r);}
.gcard-head{background:var(--bg2);padding:.5rem .75rem;border-bottom:1px solid rgba(212,160,23,.25);}
.gcard-letter{font-family:'Bebas Neue',sans-serif;font-size:1.2rem;color:var(--gold-l);line-height:1;}
.gcard-confs{font-size:.6rem;color:var(--muted);}
.gteam{display:flex;align-items:center;gap:.4rem;padding:.4rem .6rem;font-size:.78rem;border-left:2px solid transparent;}
.gteam.q{border-color:var(--green);}
.gteam .gf{font-size:.9rem;}
.gteam .gn{flex:1;font-weight:500;}
.gteam .gc{font-size:.58rem;color:var(--muted);}

/* ── STATS ── */
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-top:.5rem;}
.stat-tile{background:var(--bg3);border:1px solid rgba(255,255,255,.06);border-radius:var(--r);padding:1rem .75rem;text-align:center;}
.stat-tile.wide{grid-column:span 2;}
.stat-num{font-family:'Bebas Neue',sans-serif;font-size:2.6rem;color:var(--gold-l);line-height:1;}
.stat-unit{font-size:.72rem;color:var(--muted);margin-top:1px;}
.stat-label{font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:.3rem;}

/* ── FACTS ── */
.fact{background:var(--bg3);border:1px solid rgba(255,255,255,.06);border-radius:var(--r);padding:1rem;margin-bottom:.6rem;border-top:2px solid var(--gold);display:flex;gap:.75rem;align-items:flex-start;}
.fact-icon{font-size:1.4rem;flex-shrink:0;margin-top:1px;}
.fact-title{font-weight:600;font-size:.88rem;margin-bottom:.3rem;color:var(--gold-l);}
.fact-text{font-size:.8rem;color:var(--muted);line-height:1.6;}

/* ── FOOTER ── */
footer{text-align:center;padding:2rem 1rem 3rem;border-top:1px solid rgba(255,255,255,.06);font-size:.72rem;color:var(--muted);}
footer span{color:var(--gold);}

/* ── REVEAL ── */
.rev{opacity:0;transform:translateY(24px);transition:opacity .6s cubic-bezier(.16,1,.3,1),transform .6s cubic-bezier(.16,1,.3,1);}
.rev.vis{opacity:1;transform:none;}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a class="nav-brand" href="#">Copa 2002</a>
  <button class="hamburger" id="ham" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<ul class="nav-menu" id="navmenu">
  <li><a href="#final" onclick="closeMenu()">Final</a></li>
  <li><a href="#artilheiros" onclick="closeMenu()">Artilheiros</a></li>
  <li><a href="#caminho" onclick="closeMenu()">Mata-mata</a></li>
  <li><a href="#grupos" onclick="closeMenu()">Grupos</a></li>
  <li><a href="#numeros" onclick="closeMenu()">Números</a></li>
  <li><a href="#curiosidades" onclick="closeMenu()">Curiosidades</a></li>
</ul>

<!-- HERO -->
<div class="hero">
  <span class="ball">⚽</span>
  <p class="hero-eye">17ª Edição · Coreia do Sul &amp; Japão</p>
  <h1 class="hero-title">Copa do<br><em>Mundo</em><br>2002</h1>
  <p class="hero-sub">A primeira Copa asiática — e o pentacampeonato verde-amarelo</p>
  <div class="hero-chips">
    <span class="chip">32 Seleções</span>
    <span class="chip">64 Jogos</span>
    <span class="chip">161 Gols</span>
    <span class="chip">2,7M Pessoas</span>
  </div>
  <div class="scroll-down">Explorar</div>
</div>

<!-- FINAL -->
<section id="final">
  <p class="sec-eye rev">O Grande Desfecho</p>
  <h2 class="sec-title rev">A Final</h2>
  <hr class="gold-rule rev">

  <div class="final-box rev">
    <div class="final-date">30 de junho de 2002 · Yokohama, Japão</div>
    <div class="final-teams">
      <div>
        <span class="team-flag">🇧🇷</span>
        <div class="team-name">Brasil</div>
        <div class="team-role">Pentacampeão</div>
      </div>
      <div class="score">2–0</div>
      <div>
        <span class="team-flag">🇩🇪</span>
        <div class="team-name">Alemanha</div>
        <div class="team-role">Vice</div>
      </div>
    </div>
    <div class="goal-chips">
      <span class="goal-chip">⚽ Ronaldo 67'</span>
      <span class="goal-chip">⚽ Ronaldo 79'</span>
    </div>
  </div>

  <div class="podium rev">
    <div class="pod-card g1">
      <div class="pod-place">1º</div>
      <div class="pod-flag">🇧🇷</div>
      <div class="pod-name">Brasil</div>
      <div class="pod-detail">5º título<br>18 gols · +14</div>
    </div>
    <div class="pod-card">
      <div class="pod-place" style="color:#B4B4B4">2º</div>
      <div class="pod-flag">🇩🇪</div>
      <div class="pod-name">Alemanha</div>
      <div class="pod-detail">14 gols · +11<br>Bola de Ouro: Kahn</div>
    </div>
    <div class="pod-card">
      <div class="pod-place" style="color:#C07840">3º</div>
      <div class="pod-flag">🇹🇷</div>
      <div class="pod-name">Turquia</div>
      <div class="pod-detail">3–2 vs Coreia<br>12 gols · +4</div>
    </div>
    <div class="pod-card">
      <div class="pod-place" style="color:#556">4º</div>
      <div class="pod-flag">🇰🇷</div>
      <div class="pod-name">Coreia do Sul</div>
      <div class="pod-detail">Melhor asiático<br>11 gols · +4</div>
    </div>
  </div>
</section>

<!-- ARTILHEIROS -->
<section id="artilheiros">
  <p class="sec-eye rev">Goleadores</p>
  <h2 class="sec-title rev">Artilheiros</h2>
  <hr class="gold-rule rev">

  <div id="scorer-list">
    <div class="scorer top rev">
      <div class="sc-rank">1</div>
      <div class="sc-flag">🇧🇷</div>
      <div class="sc-info"><div class="sc-name">Ronaldo</div><div class="sc-country">Brasil</div></div>
      <div class="sc-bar-wrap"><div class="sc-bar-bg"><div class="sc-bar" data-w="100"></div></div><div class="sc-goals">8</div></div>
    </div>
    <div class="scorer rev">
      <div class="sc-rank">2</div>
      <div class="sc-flag">🇧🇷</div>
      <div class="sc-info"><div class="sc-name">Rivaldo</div><div class="sc-country">Brasil</div></div>
      <div class="sc-bar-wrap"><div class="sc-bar-bg"><div class="sc-bar" data-w="62"></div></div><div class="sc-goals">5</div></div>
    </div>
    <div class="scorer rev">
      <div class="sc-rank">2</div>
      <div class="sc-flag">🇩🇪</div>
      <div class="sc-info"><div class="sc-name">M. Klose</div><div class="sc-country">Alemanha</div></div>
      <div class="sc-bar-wrap"><div class="sc-bar-bg"><div class="sc-bar" data-w="62"></div></div><div class="sc-goals">5</div></div>
    </div>
    <div class="scorer rev">
      <div class="sc-rank">4</div>
      <div class="sc-flag">🇩🇰</div>
      <div class="sc-info"><div class="sc-name">Tomasson</div><div class="sc-country">Dinamarca</div></div>
      <div class="sc-bar-wrap"><div class="sc-bar-bg"><div class="sc-bar" data-w="50"></div></div><div class="sc-goals">4</div></div>
    </div>
    <div class="scorer rev">
      <div class="sc-rank">4</div>
      <div class="sc-flag">🇮🇹</div>
      <div class="sc-info"><div class="sc-name">C. Vieri</div><div class="sc-country">Itália</div></div>
      <div class="sc-bar-wrap"><div class="sc-bar-bg"><div class="sc-bar" data-w="50"></div></div><div class="sc-goals">4</div></div>
    </div>
  </div>
</section>

<!-- MATA-MATA -->
<section id="caminho">
  <p class="sec-eye rev">Fase Eliminatória</p>
  <h2 class="sec-title rev">Mata-mata</h2>
  <hr class="gold-rule rev">

  <div class="bracket-section rev" id="bracket"></div>
</section>

<!-- GRUPOS -->
<section id="grupos">
  <p class="sec-eye rev">Fase de Grupos</p>
  <h2 class="sec-title rev">Os 8 Grupos</h2>
  <hr class="gold-rule rev">
  <p style="font-size:.78rem;color:var(--muted);margin-bottom:.8rem;" class="rev">Borda verde = classificado para as oitavas</p>

  <div class="conf-filter rev" id="conf-filter">
    <button class="fbtn active" data-conf="all">Todos</button>
    <button class="fbtn" data-conf="UEFA">UEFA</button>
    <button class="fbtn" data-conf="CONMEBOL">CONMEBOL</button>
    <button class="fbtn" data-conf="AFC">AFC</button>
    <button class="fbtn" data-conf="CONCACAF">CONCACAF</button>
    <button class="fbtn" data-conf="CAF">CAF</button>
  </div>
  <div class="groups-grid rev" id="groups-grid"></div>
</section>

<!-- NÚMEROS -->
<section id="numeros">
  <p class="sec-eye rev">Estatísticas</p>
  <h2 class="sec-title rev">Os Números</h2>
  <hr class="gold-rule rev">

  <div class="stats-grid rev">
    <div class="stat-tile wide" style="background:linear-gradient(135deg,rgba(212,160,23,.12),var(--bg3));">
      <div class="stat-num">8</div>
      <div class="stat-unit">gols de Ronaldo</div>
      <div class="stat-label">Chuteira de Ouro</div>
    </div>
    <div class="stat-tile">
      <div class="stat-num">20</div>
      <div class="stat-label">Estádios</div>
    </div>
    <div class="stat-tile">
      <div class="stat-num">2,51</div>
      <div class="stat-unit">gols/jogo</div>
      <div class="stat-label">Média</div>
    </div>
    <div class="stat-tile wide">
      <div class="stat-num">8–0</div>
      <div class="stat-unit">Alemanha × Arábia Saudita</div>
      <div class="stat-label">Maior goleada</div>
    </div>
    <div class="stat-tile">
      <div class="stat-num">2,7M</div>
      <div class="stat-unit">espectadores</div>
      <div class="stat-label">Recorde</div>
    </div>
    <div class="stat-tile">
      <div class="stat-num">6</div>
      <div class="stat-unit">hat-tricks</div>
      <div class="stat-label">No torneio</div>
    </div>
  </div>
</section>

<!-- CURIOSIDADES -->
<section id="curiosidades">
  <p class="sec-eye rev">Você Sabia?</p>
  <h2 class="sec-title rev">Curiosidades</h2>
  <hr class="gold-rule rev">

  <div class="fact rev">
    <div class="fact-icon">🌏</div>
    <div><div class="fact-title">Primeira vez na Ásia</div><div class="fact-text">Primeiro Mundial fora da Europa e das Américas. Também a estreia de dois países co-sediando o evento.</div></div>
  </div>
  <div class="fact rev">
    <div class="fact-icon">🇰🇷</div>
    <div><div class="fact-title">Coreia do Sul nas semis</div><div class="fact-text">O anfitrião eliminou Portugal, Itália e Espanha chegando às semifinais — resultado histórico e muito polêmico.</div></div>
  </div>
  <div class="fact rev">
    <div class="fact-icon">🇫🇷</div>
    <div><div class="fact-title">Campeã humilhada</div><div class="fact-text">A França (campeã de 1998) não marcou um único gol e foi eliminada ainda na fase de grupos.</div></div>
  </div>
  <div class="fact rev">
    <div class="fact-icon">👑</div>
    <div><div class="fact-title">Ronaldo bate recorde</div><div class="fact-text">Com 15 gols em Copas, passou Romário e se tornou o maior artilheiro brasileiro da história dos Mundiais.</div></div>
  </div>
  <div class="fact rev">
    <div class="fact-icon">🧤</div>
    <div><div class="fact-title">Bola de Ouro para goleiro</div><div class="fact-text">Oliver Kahn foi eleito melhor jogador — único goleiro a ganhar o prêmio na história das Copas do Mundo.</div></div>
  </div>
  <div class="fact rev">
    <div class="fact-icon">📺</div>
    <div><div class="fact-title">Sem VAR</div><div class="fact-text">O árbitro de vídeo só viria em 2018. Em 2002, as polêmicas ficaram sem resposta.</div></div>
  </div>
</section>

<footer>
  <p>Copa do Mundo FIFA <span>2002</span> · Coreia do Sul &amp; Japão</p>
  <p style="margin-top:.3rem;font-size:.65rem;">31 mai – 30 jun 2002 · Fonte: FIFA</p>
</footer>

<script>
// ── NAV ──────────────────────────────────────────────────────────
const ham = document.getElementById('ham');
const menu = document.getElementById('navmenu');
ham.addEventListener('click', () => {
  ham.classList.toggle('open');
  menu.classList.toggle('open');
  document.body.style.overflow = menu.classList.contains('open') ? 'hidden' : '';
});
function closeMenu() {
  ham.classList.remove('open');
  menu.classList.remove('open');
  document.body.style.overflow = '';
}

// ── GROUPS DATA ──────────────────────────────────────────────────
const groups = [
  {l:'A',teams:[{n:'Dinamarca',f:'🇩🇰',c:'UEFA',q:true},{n:'Senegal',f:'🇸🇳',c:'CAF',q:true},{n:'Uruguai',f:'🇺🇾',c:'CONMEBOL',q:false},{n:'França',f:'🇫🇷',c:'UEFA',q:false}]},
  {l:'B',teams:[{n:'Espanha',f:'🇪🇸',c:'UEFA',q:true},{n:'Paraguai',f:'🇵🇾',c:'CONMEBOL',q:true},{n:'África do Sul',f:'🇿🇦',c:'CAF',q:false},{n:'Eslovênia',f:'🇸🇮',c:'UEFA',q:false}]},
  {l:'C',teams:[{n:'Brasil',f:'🇧🇷',c:'CONMEBOL',q:true},{n:'Turquia',f:'🇹🇷',c:'UEFA',q:true},{n:'Costa Rica',f:'🇨🇷',c:'CONCACAF',q:false},{n:'China',f:'🇨🇳',c:'AFC',q:false}]},
  {l:'D',teams:[{n:'Coreia do Sul',f:'🇰🇷',c:'AFC',q:true},{n:'EUA',f:'🇺🇸',c:'CONCACAF',q:true},{n:'Portugal',f:'🇵🇹',c:'UEFA',q:false},{n:'Polônia',f:'🇵🇱',c:'UEFA',q:false}]},
  {l:'E',teams:[{n:'Alemanha',f:'🇩🇪',c:'UEFA',q:true},{n:'Irlanda',f:'🇮🇪',c:'UEFA',q:true},{n:'Camarões',f:'🇨🇲',c:'CAF',q:false},{n:'Arábia Saudita',f:'🇸🇦',c:'AFC',q:false}]},
  {l:'F',teams:[{n:'Suécia',f:'🇸🇪',c:'UEFA',q:true},{n:'Inglaterra',f:'🏴󠁧󠁢󠁥󠁮󠁧󠁿',c:'UEFA',q:true},{n:'Argentina',f:'🇦🇷',c:'CONMEBOL',q:false},{n:'Nigéria',f:'🇳🇬',c:'CAF',q:false}]},
  {l:'G',teams:[{n:'México',f:'🇲🇽',c:'CONCACAF',q:true},{n:'Itália',f:'🇮🇹',c:'UEFA',q:true},{n:'Croácia',f:'🇭🇷',c:'UEFA',q:false},{n:'Equador',f:'🇪🇨',c:'CONMEBOL',q:false}]},
  {l:'H',teams:[{n:'Japão',f:'🇯🇵',c:'AFC',q:true},{n:'Bélgica',f:'🇧🇪',c:'UEFA',q:true},{n:'Rússia',f:'🇷🇺',c:'UEFA',q:false},{n:'Tunísia',f:'🇹🇳',c:'CAF',q:false}]},
];

function renderGroups(filter) {
  const grid = document.getElementById('groups-grid');
  grid.innerHTML = '';
  groups.forEach(g => {
    const shown = filter === 'all' ? g.teams : g.teams.filter(t => t.c === filter);
    if (!shown.length) return;
    const card = document.createElement('div');
    card.className = 'gcard';
    card.innerHTML = `
      <div class="gcard-head">
        <div class="gcard-letter">Grupo ${g.l}</div>
        <div class="gcard-confs">${[...new Set(g.teams.map(t=>t.c))].join(' · ')}</div>
      </div>
      ${g.teams.map(t=>`
        <div class="gteam ${t.q?'q':''}">
          <span class="gf">${t.f}</span>
          <span class="gn">${t.n}</span>
          <span class="gc">${t.c}</span>
        </div>`).join('')}
    `;
    grid.appendChild(card);
  });
}
renderGroups('all');

document.getElementById('conf-filter').addEventListener('click', e => {
  const btn = e.target.closest('.fbtn');
  if (!btn) return;
  document.querySelectorAll('.fbtn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderGroups(btn.dataset.conf);
});

// ── KNOCKOUT DATA ────────────────────────────────────────────────
const rounds = [
  { label: 'Oitavas de Final', matches: [
    [{t:'🇩🇪 Alemanha',s:'1',w:true},{t:'🇵🇾 Paraguai',s:'0',w:false}],
    [{t:'🇩🇰 Dinamarca',s:'0',w:false},{t:'🏴󠁧󠁢󠁥󠁮󠁧󠁿 Inglaterra',s:'3',w:true}],
    [{t:'🇸🇪 Suécia',s:'1',w:false},{t:'🇸🇳 Senegal',s:'2 (p.p.)',w:true}],
    [{t:'🇪🇸 Espanha',s:'1',w:false},{t:'🇮🇪 Irlanda',s:'1 (3–2p)',w:true}],
    [{t:'🇲🇽 México',s:'0',w:false},{t:'🇺🇸 EUA',s:'2',w:true}],
    [{t:'🇧🇷 Brasil',s:'2',w:true},{t:'🇧🇪 Bélgica',s:'0',w:false}],
    [{t:'🇯🇵 Japão',s:'0',w:false},{t:'🇹🇷 Turquia',s:'1',w:true}],
    [{t:'🇰🇷 Coreia do Sul',s:'2 (p.p.)',w:true},{t:'🇮🇹 Itália',s:'1',w:false}],
  ]},
  { label: 'Quartas de Final', matches: [
    [{t:'🏴󠁧󠁢󠁥󠁮󠁧󠁿 Inglaterra',s:'1',w:false},{t:'🇧🇷 Brasil',s:'2',w:true}],
    [{t:'🇩🇪 Alemanha',s:'1',w:true},{t:'🇺🇸 EUA',s:'0',w:false}],
    [{t:'🇪🇸 Espanha',s:'0 (3–5p)',w:false},{t:'🇰🇷 Coreia do Sul',s:'0',w:true}],
    [{t:'🇸🇳 Senegal',s:'0',w:false},{t:'🇹🇷 Turquia',s:'1 (p.p.)',w:true}],
  ]},
  { label: 'Semifinais', matches: [
    [{t:'🇩🇪 Alemanha',s:'1',w:true},{t:'🇰🇷 Coreia do Sul',s:'0',w:false}],
    [{t:'🇧🇷 Brasil',s:'1',w:true},{t:'🇹🇷 Turquia',s:'0',w:false}],
  ]},
  { label: '3º Lugar', matches: [
    [{t:'🇰🇷 Coreia do Sul',s:'2',w:false},{t:'🇹🇷 Turquia',s:'3',w:true}],
  ]},
  { label: 'Final — Yokohama', matches: [
    [{t:'🇩🇪 Alemanha',s:'0',w:false},{t:'🇧🇷 Brasil',s:'2 ★',w:true}],
  ], final: true},
];

const bracket = document.getElementById('bracket');
rounds.forEach(round => {
  const lbl = document.createElement('div');
  lbl.className = 'round-label';
  lbl.textContent = round.label;
  bracket.appendChild(lbl);
  round.matches.forEach(teams => {
    const m = document.createElement('div');
    m.className = 'match' + (round.final ? ' final-m' : '');
    teams.forEach(team => {
      const row = document.createElement('div');
      row.className = 'match-team ' + (team.w ? 'winner' : 'loser');
      row.innerHTML = `<span class="mt-name">${team.t}</span><span class="mt-score">${team.s}</span>`;
      m.appendChild(row);
    });
    if (round.final) {
      const badge = document.createElement('div');
      badge.className = 'champion-badge';
      badge.textContent = '★ PENTACAMPEÃO ★';
      m.appendChild(badge);
    }
    bracket.appendChild(m);
  });
});

// ── REVEAL ON SCROLL ────────────────────────────────────────────
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      e.target.classList.add('vis');
      if (e.target.id === 'scorer-list') {
        setTimeout(() => {
          document.querySelectorAll('.sc-bar').forEach(b => { b.style.width = b.dataset.w + '%'; });
        }, 100);
      }
    }
  });
}, { threshold: 0.08 });

document.querySelectorAll('.rev').forEach(el => observer.observe(el));
</script>
</body>
</html>
